<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Background audio playback -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".StillMomentApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StillMoment"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="@string/app_name"
            android:theme="@style/Theme.StillMoment">

            <!--
              TEMPORAERER Opt-out (android-081): Ab targetSdk 36 ignoriert Android
              android:screenOrientation (und resizableActivity/minAspectRatio/maxAspectRatio)
              auf Displays ab 600dp kleinster Breite - Tablets, aufgefaltete Foldables.
              Diese Property haelt das Hochformat oben dort weiter durch.

              ACHTUNG BEIM NAECHSTEN PFLICHT-BUMP: Der Opt-out wirkt NUR bis targetSdk 36.
              Ab targetSdk 37 entfernt das Framework die Opt-out-Moeglichkeit; die
              Beschraenkungen werden dann auf >=600dp immer ignoriert. Vor dem Bump auf 37
              braucht die App echte adaptive Layouts fuer Querformat - das ist Entwurfsarbeit,
              kein Manifest-Eintrag. Siehe dev-docs/tickets/android/android-081-target-sdk-36-android-16.md
              https://developer.android.com/about/versions/16/behavior-changes-16#adaptive-layouts
            -->
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with" file association for audio files -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/mpeg" />
                <data android:mimeType="audio/mp4" />
                <data android:mimeType="audio/x-m4a" />
            </intent-filter>

            <!-- "Share" intent for audio files -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/mpeg" />
                <data android:mimeType="audio/mp4" />
                <data android:mimeType="audio/x-m4a" />
            </intent-filter>

            <!-- "Share" intent for plain text URLs (e.g. Chrome audio player share) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Foreground Service for timer background playback -->
        <service
            android:name=".infrastructure.audio.TimerForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Foreground Service for guided meditation playback with MediaSession -->
        <service
            android:name=".infrastructure.audio.MeditationPlayerForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

    </application>

</manifest>
